    {
      "@id": "https://litlfred.github.io/bootstrap/bootstrap.jsonld#process/Process_Discussion/node/Start_Discussion",
      "@type": "bootstrap:ProcessNode",
      "isPartOf": "https://litlfred.github.io/bootstrap/bootstrap.jsonld#process/Process_Discussion",
